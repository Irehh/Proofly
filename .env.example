# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Proofly Backend Server & App URLs
PROOFLY_SERVER_PORT="8080"
PROOFLY_FRONTEND_BASE_URL="http://localhost:3000"
PROOFLY_API_BASE_URL="http://localhost:8080"
PROOFLY_SUPPORT_EMAIL="support@proofly.com"

# Control Plane & Tenant DB
PROOFLY_CONTROL_DB_URL="jdbc:postgresql://localhost:5432/proofly_control"
PROOFLY_CONTROL_DB_USERNAME="proofly_admin"
PROOFLY_CONTROL_DB_PASSWORD="CHANGE_ME_LOCAL_ONLY"
PROOFLY_TENANT_DB_HOST="localhost"
PROOFLY_TENANT_DB_PORT="5432"
PROOFLY_TENANT_DB_USERNAME="proofly_admin"
PROOFLY_TENANT_DB_PASSWORD="CHANGE_ME_LOCAL_ONLY"
PROOFLY_USE_PGBOUNCER="false"
PROOFLY_EXPECTED_TENANT_SCHEMA="2"

# Redis & Security
PROOFLY_REDIS_HOST="localhost"
PROOFLY_REDIS_PORT="6379"
PROOFLY_REDIS_PASSWORD=""
PROOFLY_JWT_ISSUER="https://api.proofly.com"
PROOFLY_JWT_KEY_ID="proofly-k1"
PROOFLY_ACCESS_TOKEN_TTL_SEC="900"
PROOFLY_REFRESH_TOKEN_TTL_SEC="2592000"
PROOFLY_COOKIE_SECURE="false"
PROOFLY_PIN_MAX_ATTEMPTS="5"
PROOFLY_PIN_LOCKOUT_MINUTES="15"
PROOFLY_RESET_TOKEN_TTL_MINUTES="15"
PROOFLY_VERIFY_TOKEN_TTL_HOURS="24"
# Generate with: openssl rand -base64 32
PROOFLY_PII_KEY_BASE64="CHANGE_ME_32_BYTE_BASE64_KEY"
PROOFLY_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Notifications (Mailpit local / SMTP prod + SMS)
PROOFLY_SMTP_HOST="localhost"
PROOFLY_SMTP_PORT="1025"
PROOFLY_SMTP_USERNAME=""
PROOFLY_SMTP_PASSWORD=""
PROOFLY_SMTP_AUTH="false"
PROOFLY_SMTP_STARTTLS="false"
PROOFLY_MAIL_FROM="no-reply@proofly.com"
PROOFLY_MAIL_FROM_NAME="Proofly"
PROOFLY_SMS_PROVIDER="log"
PROOFLY_SMS_API_URL=""
PROOFLY_SMS_API_KEY=""
PROOFLY_SMS_SENDER_ID="Proofly"
PROOFLY_NOTIFY_MAX_ATTEMPTS="5"
PROOFLY_NOTIFY_RETRY_SEC="30"
PROOFLY_NOTIFY_PROCESSING_TIMEOUT_SEC="120"

# Multi-Currency Gateway-Routed Billing & Ledger
