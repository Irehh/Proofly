PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_key"
PAYSTACK_WEBHOOK_SECRET="sk_test_replace_with_your_key"
PAYSTACK_CALLBACK_URL="http://localhost:3000/billing/callback"

PROOFLY_STRIPE_CURRENCIES="USD,GBP"
