# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Proofly Backend (Control Plane & Tenant Provisioning)
PROOFLY_CONTROL_DB_URL="jdbc:postgresql://localhost:5432/proofly_control"
PROOFLY_CONTROL_DB_USERNAME="proofly_admin"
PROOFLY_CONTROL_DB_PASSWORD="CHANGE_ME_LOCAL_ONLY"
PROOFLY_TENANT_DB_HOST="localhost"
PROOFLY_TENANT_DB_PORT="5432"
PROOFLY_TENANT_DB_USERNAME="proofly_admin"
PROOFLY_TENANT_DB_PASSWORD="CHANGE_ME_LOCAL_ONLY"
PROOFLY_USE_PGBOUNCER="false"

# Redis & Security
PROOFLY_REDIS_HOST="localhost"
PROOFLY_REDIS_PORT="6379"
PROOFLY_JWT_ISSUER="https://api.proofly.com"
PROOFLY_JWT_KEY_ID="proofly-k1"
# Base64-encoded 256-bit key for AES-256-GCM PII & MFA secret encryption
PROOFLY_PII_KEY_BASE64="CHANGE_ME_32_BYTE_BASE64_KEY"
PROOFLY_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Mailpit / SMTP
PROOFLY_SMTP_HOST="localhost"
PROOFLY_SMTP_PORT="1025"

# Frontend
VITE_API_BASE_URL="http://localhost:8080"
